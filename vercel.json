{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/public/:path*", "destination": "/:path*" },
    { "source": "/watch", "destination": "/watch.html" },
    { "source": "/browse", "destination": "/browse.html" },
    { "source": "/person/:id", "destination": "/person.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/analytics", "destination": "/analytics.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
